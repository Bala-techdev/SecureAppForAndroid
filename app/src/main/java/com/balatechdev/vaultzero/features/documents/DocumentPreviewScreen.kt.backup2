import com.balatechdev.vaultzero.core.designsystem.theme.VaultSecurityAlert
import com.balatechdev.vaultzero.data.model.DocumentCategory
import com.balatechdev.vaultzero.data.repository.DocumentRepository
import com.balatechdev.vaultzero.security.MemoryZeroizer
import com.balatechdev.vaultzero.security.WindowSecurityManager
import com.balatechdev.vaultzero.security.crypto.DocumentCryptoEngine
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import java.io.File

@Composable
fun DocumentPreviewScreen(
    documentId: String,
    repository: DocumentRepository? = null,
    onNavigateBack: () -> Unit,
    onDeleteSuccess: () -> Unit,
    modifier: Modifier = Modifier
) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()
    val snackbarHostState = remember { SnackbarHostState() }
    val scrollState = rememberScrollState()

    // Enforce FLAG_SECURE on preview window
    DisposableEffect(Unit) {
        val window = (context as? Activity)?.window
        if (window != null) {
            WindowSecurityManager.enableSecureScreen(window)
        }
        onDispose { }
    }

    val dbEntity = repository?.getDocumentById(documentId)
    val document = dbEntity?.toDocumentItem()

    if (document == null) {
        Scaffold(
            modifier = modifier.fillMaxSize(),
            topBar = {
                VaultTopAppBar(
                    title = "Document Preview",
                    onNavigateBack = onNavigateBack
                )
            }
        ) { paddingValues ->
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(paddingValues),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = "Document not found or has been deleted.",
                    style = MaterialTheme.typography.bodyLarge,
                    color = MaterialTheme.colorScheme.onSurfaceVariant
                )
            }
        }
        return
    }

    var docTitle by remember { mutableStateOf(document.title) }
    var docCategory by remember { mutableStateOf(dbEntity?.categoryId ?: document.categoryId) }
    var showDeleteDialog by remember { mutableStateOf(false) }
    var showRenameDialog by remember { mutableStateOf(false) }
    var showCategoryMenu by remember { mutableStateOf(false) }
    var renameInput by remember { mutableStateOf(document.title) }

   // Document preview state
    var previewBitmap by remember { mutableStateOf<Bitmap?>(null) }
    var previewError by remember { mutableStateOf<String?>(null) }
    var tempPdfFile by remember { mutableStateOf<File?>(null) }
    var pdfPageCount by remember { mutableStateOf(0) }

    // Decrypt and load preview
    // Decrypt and prepare document preview
    LaunchedEffect(documentId) {
        if (repository != null && dbEntity != null) {
            try {
                val ext = dbEntity.fileExtension.lowercase()

                if (ext == "jpg" || ext == "jpeg" || ext == "png") {
                    val bitmap = withContext(Dispatchers.IO) {
                        val decryptedBytes =
                            repository.decryptDocumentToBytes(documentId)

                        try {
                            BitmapFactory.decodeByteArray(
                                decryptedBytes,
                                0,
                                decryptedBytes.size
                            )
                        } finally {
                            MemoryZeroizer.zeroize(decryptedBytes)
                        }
                    }

                    if (bitmap != null) {
                        previewBitmap = bitmap
                    } else {
                        previewError = "Unable to decode this image."
                    }

                } else if (ext == "pdf") {
                    val tempDir = File(context.cacheDir, "preview_tmp")

                    val temp = withContext(Dispatchers.IO) {
                        repository.decryptDocumentToTempFile(
                            documentId = documentId,
                            tempDir = tempDir
                        )
                    }

                    val pageCount = withContext(Dispatchers.IO) {
                        val pfd = ParcelFileDescriptor.open(
                            temp,
                            ParcelFileDescriptor.MODE_READ_ONLY
                        )

                        try {
                            PdfRenderer(pfd).use { renderer ->
                                renderer.pageCount
                            }
                        } finally {
                            pfd.close()
                        }
                    }

                    tempPdfFile = temp
                    pdfPageCount = pageCount

                    if (pageCount == 0) {
                        previewError = "This PDF contains no pages."
                    }

                } else {
                    previewError = "This file format is not supported."
                }

            } catch (e: Exception) {
                previewError = e.message ?: "Unable to load document."
            }
        }
    }

    // Clean volatile preview temp file on exit
    DisposableEffect(documentId) {
        onDispose {
            tempPdfFile?.let { temp ->
                DocumentCryptoEngine.secureWipeAndDelete(temp)
            }
        }
    }

    // Rename Dialog
    if (showRenameDialog) {
        AlertDialog(
            onDismissRequest = { showRenameDialog = false },
            title = { Text("Rename Document") },
            text = {
                OutlinedTextField(
                    value = renameInput,
                    onValueChange = { renameInput = it },
                    label = { Text("Title") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
            },
            confirmButton = {
                TextButton(
                    onClick = {
                        if (renameInput.isNotBlank()) {
                            docTitle = renameInput.trim()
                            repository?.renameDocument(documentId, renameInput.trim())
                            showRenameDialog = false
                            scope.launch { snackbarHostState.showSnackbar("Document renamed") }
                        }
                    }
                ) {
                    Text("Save", color = VaultEmeraldPrimary, fontWeight = FontWeight.Bold)
                }
            },
            dismissButton = {
                TextButton(onClick = { showRenameDialog = false }) { Text("Cancel") }
            }
        )
    }

    // Delete Confirmation Dialog
    if (showDeleteDialog) {
        AlertDialog(
            onDismissRequest = { showDeleteDialog = false },
            title = { Text("Delete Encrypted Document") },
            text = { Text("Are you sure you want to permanently delete \"$docTitle\"? The encrypted file will be securely zeroized from internal storage.") },
            confirmButton = {
                TextButton(
                    onClick = {
                        showDeleteDialog = false
                        repository?.deleteDocument(documentId)
                        onDeleteSuccess()
                    }
                ) {
                    Text("Delete", color = VaultSecurityAlert, fontWeight = FontWeight.Bold)
                }
            },
            dismissButton = {
                TextButton(onClick = { showDeleteDialog = false }) {
                    Text("Cancel")
                }
            }
        )
    }

    Scaffold(
        modifier = modifier.fillMaxSize(),
        topBar = {
            VaultTopAppBar(
                title = docTitle,
                onNavigateBack = onNavigateBack,
                actions = {
                    IconButton(onClick = { showRenameDialog = true }) {
                        Icon(imageVector = Icons.Default.Edit, contentDescription = "Rename")
                    }
                    IconButton(onClick = { showDeleteDialog = true }) {
                        Icon(
                            imageVector = Icons.Default.Delete,
                            contentDescription = "Delete Document",
                            tint = VaultSecurityAlert
                        )
                    }
                }
            )
        },
        snackbarHost = { SnackbarHost(snackbarHostState) },
        containerColor = MaterialTheme.colorScheme.background
    ) { paddingValues ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues)
                .padding(16.dp)
                .verticalScroll(scrollState),
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {
            // Document Metadata Card
            VaultCard {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        modifier = Modifier
                            .size(50.dp)
                            .clip(RoundedCornerShape(12.dp))
                            .background(VaultCategoryPurple.copy(alpha = 0.15f)),
                        contentAlignment = Alignment.Center
                    ) {
                        Text(
                            text = document.fileExtension,
                            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold),
                            color = VaultCategoryPurple
                        )
                    }

                    Spacer(modifier = Modifier.width(16.dp))

                    Column(modifier = Modifier.weight(1f)) {
                        Text(
                            text = docTitle,
                            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold),
                            color = MaterialTheme.colorScheme.onSurface
                        )
                        Text(
                            text = "${document.fileName} • ${document.fileSizeFormatted} • ${document.addedDate}",
                            style = MaterialTheme.typography.bodyMedium,
                            color = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                    }
                }

                Spacer(modifier = Modifier.height(12.dp))

                // Categorize Row
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    val currentCatName = DocumentCategory.fromId(docCategory).displayName
                    Text(
                        text = "Category: $currentCatName",
                        style = MaterialTheme.typography.labelSmall,
                        color = VaultEmeraldPrimary,
                        fontWeight = FontWeight.Bold
                    )
                    Box {
                        TextButton(onClick = { showCategoryMenu = true }) {
                            Icon(imageVector = Icons.Default.Folder, contentDescription = null, modifier = Modifier.size(16.dp))
                            Spacer(modifier = Modifier.width(4.dp))
                            Text("Change Category")
                        }
                        DropdownMenu(
                            expanded = showCategoryMenu,
                            onDismissRequest = { showCategoryMenu = false }
                        ) {
                            DocumentCategory.entries.forEach { cat ->
                                DropdownMenuItem(
                                    text = { Text(cat.displayName) },
                                    onClick = {
                                        docCategory = cat.id
                                        repository?.updateCategory(documentId, cat.id)
                                        showCategoryMenu = false
                                        scope.launch { snackbarHostState.showSnackbar("Category set to ${cat.displayName}") }
                                    }
                                )
                            }
                        }
                    }
                }
            }

            // Secure In-Memory Document Viewer Canvas
           // Document Viewer
                Column(
                    modifier = Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(16.dp))
                        .background(MaterialTheme.colorScheme.surface)
                        .border(
                            1.dp,
                            MaterialTheme.colorScheme.outlineVariant,
                            RoundedCornerShape(16.dp)
                        )
                        .padding(12.dp),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    Text(
                        text = "DOCUMENT VIEWER",
                        style = MaterialTheme.typography.titleSmall,
                        color = VaultEmeraldPrimary,
                        fontWeight = FontWeight.Bold
                    )

                    when {
                        previewError != null -> {
                            Text(
                                text = previewError!!,
                                color = MaterialTheme.colorScheme.error
                            )
                        }

                        document.fileExtension.equals("pdf", ignoreCase = true) -> {
                            val pdfFile = tempPdfFile

                            if (pdfFile != null && pdfPageCount > 0) {
                                Text(
                                    text = "$pdfPageCount pages",
                                    style = MaterialTheme.typography.labelMedium,
                                    color = MaterialTheme.colorScheme.onSurfaceVariant
                                )

                                LazyColumn(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .height(600.dp),
                                    verticalArrangement = Arrangement.spacedBy(16.dp)
                                ) {
                                    items((0 until pdfPageCount).toList()) { pageIndex ->
                                        key(pageIndex) {
                                            PdfPageViewer(
                                                pdfFile = pdfFile,
                                                pageIndex = pageIndex
                                            )
                                        }
                                    }
                                }
                            } else {
                                Text(
                                    text = "Preparing PDF preview...",
                                    color = MaterialTheme.colorScheme.onSurfaceVariant
                                )
                            }
                        }

                        previewBitmap != null -> {
                            Image(
                                bitmap = previewBitmap!!.asImageBitmap(),
                                contentDescription = "Document image preview",
                                modifier = Modifier.fillMaxWidth(),
                                contentScale = ContentScale.Fit
                            )
                        }

                        else -> {
                            Column(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .height(220.dp),
                                horizontalAlignment = Alignment.CenterHorizontally,
                                verticalArrangement = Arrangement.Center
                            ) {
                                Icon(
                                    imageVector = Icons.Default.Shield,
                                    contentDescription = null,
                                    tint = VaultEmeraldPrimary,
                                    modifier = Modifier.size(48.dp)
                                )

                                Spacer(modifier = Modifier.height(12.dp))

                                Text(
                                    text = "Loading document preview...",
                                    color = MaterialTheme.colorScheme.onSurfaceVariant
                                )
                            }
                        }
                    }
                }

            // Document Notes
            if (document.notes.isNotEmpty()) {
                VaultCard {
                    Text(
                        text = "NOTES",
                        style = MaterialTheme.typography.labelSmall,
                        color = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                    Spacer(modifier = Modifier.height(6.dp))
                    Text(
                        text = document.notes,
                        style = MaterialTheme.typography.bodyMedium,
                        color = MaterialTheme.colorScheme.onSurface
                    )
                }
            }

            // Export Decrypted Copy via SAF Button
            Button(
                onClick = {
                    scope.launch {
                        snackbarHostState.showSnackbar("SAF Export launched: Securely export to chosen destination")
                    }
                },
                modifier = Modifier
                    .fillMaxWidth()
                    .height(52.dp),
                shape = RoundedCornerShape(14.dp),
                colors = ButtonDefaults.buttonColors(containerColor = VaultEmeraldPrimary)
            ) {
                Icon(imageVector = Icons.Default.FileDownload, contentDescription = null)
                Spacer(modifier = Modifier.width(8.dp))
                Text("EXPORT DECRYPTED FILE VIA SAF", fontWeight = FontWeight.Bold)
            }

            OutlinedButton(
                onClick = { showDeleteDialog = true },
                modifier = Modifier
                    .fillMaxWidth()
                    .height(52.dp),
                shape = RoundedCornerShape(14.dp),
                colors = ButtonDefaults.outlinedButtonColors(contentColor = VaultSecurityAlert)
            ) {
                Icon(imageVector = Icons.Default.Delete, contentDescription = null)
                Spacer(modifier = Modifier.width(8.dp))
                Text("DELETE FROM VAULT", fontWeight = FontWeight.Bold)
            }
        }
    }
}

